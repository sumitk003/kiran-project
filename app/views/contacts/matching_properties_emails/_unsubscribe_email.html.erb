<%= body.html_safe %>
<div class="mb-4">
  <% if agent.mobile.present? %>
    <p class="block text-sm">Mobile:&nbsp;<%= agent.mobile %></p>
  <% end %>

  <% if agent.phone.present? %>
    <p class="block text-sm">Phone:&nbsp;<%= agent.phone %></p>
  <% end %>

  <% if agent.fax.present? %>
    <p class="block text-sm">Fax:&nbsp;<%= agent.fax %></p>
  <% end %>
</div>

<!-- Properties Summary Table -->
<% if properties.any? %>
  <div class="mb-8 overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200 border border-gray-300">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b border-gray-300">ID</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b border-gray-300">Contract</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b border-gray-300">Street</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b border-gray-300">Suburb</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b border-gray-300">Type</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b border-gray-300">Total Area</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% properties.each do |property| %>
          <tr>
            <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900"><%= property.internal_id %></td>
            <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900">
              <% if property.contract.present? %>
                <% if property.contract.for_sale? && property.contract.for_lease? %>
                  For Sale / For Lease
                <% elsif property.contract.for_sale? %>
                  For Sale
                <% elsif property.contract.for_lease? %>
                  For Lease
                <% else %>
                  -
                <% end %>
              <% else %>
                -
              <% end %>
            </td>
            <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900"><%= property.number_and_street.presence || '-' %></td>
            <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900"><%= property.city.presence || '-' %></td>
            <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900"><%= property.type_label.presence || property.type.presence || '-' %></td>
            <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900">
              <%= property.building_area.present? && property.building_area > 0 ? "#{property.building_area.to_i} m²" : '-' %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<p class="text-sm text-gray-500 mb-4">You are receiving this email because you have contacted <%= agent.account.company_name %> and you are currently searching for commercial, industrial and/or retail properties.</p>

<!-- Unsubscribe link -->
<div class="mt-6 pt-4 border-t border-gray-200">
  <p class="text-xs text-gray-400 text-center mb-2">
    If you no longer wish to receive these emails, you can 
    <%= link_to 'unsubscribe here', unsubscribe_url(
      email: contact.email,
      account_id: agent.account.id,
      token: generate_unsubscribe_token(contact.email, agent.account.id)
    ), class: 'text-blue-600 underline' %>.
  </p>
</div>
